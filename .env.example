# OpenAI API Key (optional - use if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk_your_key_here

# Anthropic Claude API Key (optional - use if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Groq API Key (optional - use if LLM_PROVIDER=groq) - FREE!
GROQ_API_KEY=gsk_your_groq_key_here

# LLM Provider (openai, claude, or groq)
LLM_PROVIDER=groq

# Model to use (depends on provider)
# For OpenAI: gpt-4o, gpt-4o-mini, etc.
# For Claude: claude-3-5-sonnet-20241022, claude-3-haiku-20240307, etc.
# For Groq: llama3-8b-8192, llama3-70b-8192, mixtral-8x7b-32768, etc.
LLM_MODEL=llama-3.1-8b-instant
PINECONE_API_KEY=your_pinecone_api_key_here

# Output directory for processed documents
OUTPUT_DIR=./outputs